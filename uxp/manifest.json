{
  "manifestVersion": 6,
  "id": "com.thinkvp.unphased",
  "name": "Unphased",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "unphased.panel",
      "label": { "default": "Unphased" },
      "minimumSize": { "width": 340, "height": 400 },
      "preferredDockedSize": { "width": 400, "height": 700 },
      "preferredFloatingSize": { "width": 440, "height": 760 }
    }
  ],
  "addon": {
    "name": "unphased.uxpaddon"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "enableAddon": true,
    "allowCodeGenerationFromStrings": false
  }
}
