node_modules/
engine/fixtures/
*.log
tmp/

# testmedia/ is DENY-BY-DEFAULT on purpose. It is the folder real recordings get
# dropped into while testing, and production audio must never end up in a public
# repo — so only the four files `node engine/cli.js gen-fixtures testmedia`
# generates are allowed through, by name. Anything else you put here is ignored
# unless you add it deliberately below.
testmedia/*
!testmedia/boom.wav
!testmedia/lav1.wav
!testmedia/lav2.wav
!testmedia/ground-truth.json

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# UXP build outputs. The Windows native addon (uxp/win/x64/*.uxpaddon) IS
# committed — it is the artifact build-ccx.js packages, and rebuilding a static
# FFmpeg on every CI run for a file that changes twice a year is not worth it.
#
# The macOS addon is NOT committed: it cannot be built on the Windows dev
# machine, so CI builds it from source on every release and the .ccx assembles
# all three platform slices there. Anything under uxp/mac/ is a local build.
uxp/mac/
uxp/dist/
uxp/native/build/
uxp/native/uxp/win/build/
uxp/native/third_party/
uxp/ffmpeg-out/
